{
  "name": "feedback-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback-hub",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
    }
  ],
  "services": [
    {
      "binding": "AI_PLATFORM_CORE_SERVICE",
      "service": "ai-platform-core"
    }
  ],
  "vars": {
    "APP_NAME": "feedback-hub",
    "CONTRACT_VERSION": "0.1.0",
    "AI_PLATFORM_CORE_BASE_URL": "https://ai-platform-core.karukimori.workers.dev"
  }
}
